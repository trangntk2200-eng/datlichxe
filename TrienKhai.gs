p\" id=\"schedule\"\u003e\u003c/div\u003e\u003cp class=\"hint\"\u003eChọn tối đa 2 khung giờ trên cùng một xe. Lịch được cập nhật tự động mỗi 30 giây.\u003c/p\u003e\u003c/div\u003e\u003c/div\u003e\n\u003caside\u003e\u003cdiv class=\"card\"\u003e\u003ch2 class=\"aside-title\"\u003e\u003cspan class=\"step\"\u003e03\u003c/span\u003e Thông tin đăng ký\u003c/h2\u003e\u003cform id=\"booking-form\"\u003e\u003cdiv class=\"field\"\u003e\u003clabel for=\"name\"\u003eTên học viên *\u003c/label\u003e\u003cinput id=\"name\" required maxlength=\"100\" placeholder=\"Nhập họ và tên học viên\" autocomplete=\"name\"\u003e\u003c/div\u003e\u003cdiv class=\"field\"\u003e\u003clabel for=\"teacher\"\u003eGiáo viên hướng dẫn *\u003c/label\u003e\u003cinput id=\"teacher\" required maxlength=\"100\" placeholder=\"Nhập họ và tên thầy / cô\"\u003e\u003c/div\u003e\u003cdiv class=\"summary\" id=\"summary\"\u003eChưa chọn xe và giờ tập.\u003c/div\u003e\u003cbutton class=\"primary wide\" id=\"submit-book\"\u003eXác nhận đặt lịch \u0026nbsp; →\u003c/button\u003e\u003cp class=\"hint\"\u003eKiểm tra thông tin trước khi xác nhận. Liên hệ trung tâm nếu cần thay đổi hoặc hủy lịch.\u003c/p\u003e\u003c/form\u003e\u003c/div\u003e\u003cdiv class=\"notice\"\u003e\u003cb\u003eMỗi giờ tập, một bước tiến.\u003c/b\u003e\u003cbr\u003eVui lòng có mặt trước giờ tập 10 phút và mang theo giấy tờ học viên.\u003c/div\u003e\u003c/aside\u003e\u003c/div\u003e\u003c/section\u003e\n\u003csection id=\"admin-screen\" class=\"hidden\"\u003e\u003cdiv id=\"login\" class=\"card\" style=\"max-width:420px;margin:auto\"\u003e\u003ch2\u003eĐăng nhập quản trị\u003c/h2\u003e\u003cform id=\"login-form\"\u003e\u003clabel for=\"password\"\u003eMật khẩu quản trị\u003c/label\u003e\u003cinput id=\"password\" type=\"password\" required autocomplete=\"current-password\"\u003e\u003cp class=\"hint\"\u003eMật khẩu được cấu hình trong Script properties.\u003c/p\u003e\u003cbutton class=\"primary wide\"\u003eĐăng nhập\u003c/button\u003e\u003c/form\u0